# Leon AI Environment Configuration

# Leon AI Server Configuration
LEON_HOST=http://localhost
LEON_PORT=1337
LEON_API_KEY=
LEON_LANGUAGE=en-US

# Leon AI Features
LEON_ENABLE_STT=true
LEON_ENABLE_TTS=true
LEON_ENABLE_HOTWORD=false

# Leon AI Offline Mode (for privacy)
LEON_OFFLINE_MODE=false

# HeyGen Configuration (for alive avatar)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=

# Avatar Quality Settings
AVATAR_QUALITY=high
AVATAR_ENABLE_VOICE=true

# Backend Configuration
BACKEND_PORT=3001
BACKEND_HOST=http://localhost

# Frontend Configuration
VITE_LEON_HOST=http://localhost
VITE_LEON_PORT=1337
VITE_BACKEND_URL=http://localhost:3001
