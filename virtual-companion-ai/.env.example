# ===========================================
# HAPVE Virtual Companion AI - Environment Variables
# ===========================================

# Backend Configuration
PORT=4000
FRONTEND_URL=http://localhost:3006
NODE_ENV=development

# ===========================================
# AI SERVICES (Required for full functionality)
# ===========================================

# OpenAI GPT-4 (for intelligent conversations)
# Get your key at: https://platform.openai.com/api-keys
VITE_OPENAI_API_KEY=sk-your-openai-api-key-here

# HeyGen Streaming Avatar (for photo-realistic live avatars)
# Get your key at: https://app.heygen.com/settings?nav=API
VITE_HEYGEN_API_KEY=your-heygen-api-key-here

# ElevenLabs Voice (optional, for premium voice synthesis)
# Get your key at: https://elevenlabs.io/
VITE_ELEVENLABS_API_KEY=your-elevenlabs-api-key-here

# ===========================================
# DATABASE (Optional - app works without it)
# ===========================================

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=hapve_companion

# Redis Configuration (for caching)
REDIS_URL=redis://localhost:6379

# ===========================================
# BLOCKCHAIN (Optional - Web3 features)
# ===========================================

# Ethereum/Polygon RPC URLs
VITE_ETHEREUM_RPC=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
VITE_POLYGON_RPC=https://polygon-rpc.com
VITE_LOCAL_RPC=http://localhost:8545

# WalletConnect Project ID
VITE_WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id

# Smart Contract Addresses (deployed)
VITE_NFT_CONTRACT_ADDRESS=0x...
VITE_TOKEN_CONTRACT_ADDRESS=0x...
VITE_GOVERNANCE_CONTRACT_ADDRESS=0x...

# ===========================================
# SECURITY
# ===========================================

# JWT Secret (for backend authentication)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Encryption Key (for data encryption)
ENCRYPTION_KEY=your-32-character-encryption-key

# ===========================================
# FEATURE FLAGS
# ===========================================

# Enable/disable features
VITE_ENABLE_BLOCKCHAIN=false
VITE_ENABLE_DATABASE=false
VITE_ENABLE_REDIS=false
VITE_ENABLE_HEYGEN=true
VITE_ENABLE_GPT4=true

# ===========================================
# QUICK SETUP GUIDE
# ===========================================
#
# MINIMUM REQUIRED (for basic functionality):
# - No configuration needed! App works out of the box.
#
# FOR GPT-4 AI (recommended):
# 1. Go to https://platform.openai.com/api-keys
# 2. Create API key
# 3. Set VITE_OPENAI_API_KEY above
#
# FOR HEYGEN LIVE AVATARS:
# 1. Go to https://app.heygen.com/
# 2. Sign up and get API key
# 3. Set VITE_HEYGEN_API_KEY above
#
# Copy this file to .env and fill in your values
# ===========================================
